# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Imagen del reporteador para Render.
#
# Modelo: el ETL se ejecuta en local y en Render solo corre la web, leyendo los
# Parquet/Gold que se suben al disco persistente montado en /data.
#
# Diferencias con `web/Dockerfile` (local):
#   - Se instala con uv en multiplas etapas (Render compila con BuildKit).
#   - No copia el codigo del ETL: aqui no se ejecuta ningun paso del pipeline.
#   - Arranca como root solo para preparar el disco persistente y baja a `app`.
#   - Deja ~/.ssh (0700) listo para que Render permita `ssh`/`scp` al servicio,
#     que es como subimos los datos desde el PC.
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.13.6 AS uv

# ------------------------------------------------------------------ builder
FROM python:3.12-slim-bookworm AS builder

COPY --from=uv /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY web/pyproject.toml web/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

COPY web/app ./app

# ------------------------------------------------------------------ runtime
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH" \
    DATA_DIR=/data

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app \
        --shell /bin/bash app \
    && mkdir -p /data /app /home/app/.ssh /root/.ssh \
    && chown -R app:app /data /app /home/app \
    && chmod 0700 /home/app/.ssh /root/.ssh

WORKDIR /app

COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app web/app /app/app
COPY --chown=app:app web/pyproject.toml /app/pyproject.toml
COPY --chown=app:app web/entrypoint.render.sh /app/entrypoint.render.sh

RUN chmod +x /app/entrypoint.render.sh

EXPOSE 10000

HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import os, urllib.request; port=os.environ.get('PORT', '10000'); urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=3)"

# Root solo durante el entrypoint: ajusta /data y cede el proceso a `app`.
USER root

ENTRYPOINT ["/app/entrypoint.render.sh"]
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
