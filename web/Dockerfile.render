# Dockerfile para Render (Web Service)
# Basado en web/Dockerfile pero con adaptaciones:
# - Usa $PORT (Render asigna puerto dinámico)
# - Instala dependencias con pip (Render no tiene uv en runtime)
# - Expone puerto dinámico

FROM python:3.12-slim-bookworm

# Variables de entorno
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DATA_DIR=/data \
    SQL_DIR=/sql

# Crear usuario no-root
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app app \
    && mkdir -p /data /app /sql \
    && chown -R app:app /data /app /sql

WORKDIR /app

# Copiar dependencias primero (para caché de capas)
COPY web/pyproject.toml web/uv.lock ./
# Instalar dependencias con pip (Render no tiene uv)
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r <(grep -v '^#' uv.lock | grep -v '^$' | awk -F'=' '{print $1}')

# Copiar aplicación
COPY web/app /app/app

# Script para iniciar con puerto dinámico
RUN echo '#!/bin/sh\nexec uvicorn app.main:app --host 0.0.0.0 --port $PORT' > /app/start.sh \
    && chmod +x /app/start.sh \
    && chown -R app:app /app

USER app

# Exponer puerto dinámico (Render usa $PORT)
EXPOSE 10000
# (Render ignora EXPOSE; usa $PORT interno)

# Health check (usando el mismo puerto dinámico)
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=5 \
    CMD python -c "import os, urllib.request; port=os.environ.get('PORT', '8000'); urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=3)"

CMD ["/app/start.sh"]