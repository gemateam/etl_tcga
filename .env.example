# Copia este archivo a .env y cambia las contraseñas antes de usar el proyecto.
# No se versiona ningún .env real ni se incluyen secretos en las imágenes.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=tcga
POSTGRES_USER=tcga_admin
POSTGRES_PASSWORD=cambia_esta_clave_postgres
ETL_DB_USER=etl_rw
ETL_DB_PASSWORD=cambia_esta_clave_etl
WEB_DB_USER=web_ro
WEB_DB_PASSWORD=cambia_esta_clave_web

# ---------------------------------------------------------------------- GDC
GDC_PROJECTS=TCGA-BRCA
GDC_API_URL=https://api.gdc.cancer.gov
GDC_DOWNLOAD_WORKERS=2
GDC_DOWNLOAD_BATCH_BYTES=1000000000
GDC_HTTP_TIMEOUT=120
GDC_HTTP_RETRIES=5
GDC_HTTP_BACKOFF=2

# ------------------------------------------------------------------- almacenamiento
DATA_DIR=/data
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=2

# ---------------------------------------------------------------------- web
WEB_PORT=8000
ADMINER_PORT=8080
LOG_LEVEL=INFO

# ------------------------------------------------------------------ scheduler
SCHEDULER_INTERVAL_SECONDS=604800
