# Copia este archivo a .env y cambia las contraseñas antes de usar el proyecto.
# No se versiona ningún .env real ni se incluyen secretos en las imágenes.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=tcga
POSTGRES_USER=tcga_admin
POSTGRES_PASSWORD=cambia_esta_clave_postgres
ETL_DB_USER=etl_rw
ETL_DB_PASSWORD=cambia_esta_clave_etl
WEB_DB_USER=web_ro
WEB_DB_PASSWORD=cambia_esta_clave_web

# ---------------------------------------------------------------------- GDC
GDC_PROJECTS=TCGA-BRCA
GDC_API_URL=https://api.gdc.cancer.gov
GDC_DOWNLOAD_WORKERS=2
GDC_DOWNLOAD_BATCH_BYTES=1000000000
GDC_HTTP_TIMEOUT=120
GDC_HTTP_RETRIES=5
GDC_HTTP_BACKOFF=2

# ------------------------------------------------------------------- almacenamiento
DATA_DIR=/data
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=2

# ---------------------------------------------------------------------- web
WEB_PORT=8000
ADMINER_PORT=8080
LOG_LEVEL=INFO

# ------------------------------------------------------------- ejecutor visual
# Puerto local del lienzo (solo 127.0.0.1). Se levanta con el perfil `flow`:
#   docker compose --profile flow up -d --build flow
FLOW_PORT=8100
# Directorio de insumos locales Romero / GEMAMX (por defecto dentro de data/inputs/romero)
GEMAMX_DIR=./data/inputs/romero
# Autenticación HTTP Basic opcional. Si defines ambas variables, todo el lienzo
# (excepto /health) exige credenciales. Obligatorio si publicas el servicio.
# FLOW_AUTH_USER=operador
# FLOW_AUTH_PASSWORD=cambia_esta_clave_flow

# ------------------------------------------------------------------ Render
# La sincronización local -> Render NO usa este fichero: los datos de conexión
# van en `.env.render` (ignorado por git) o como variables de entorno.
# Ver README_RENDER.md y scripts/render_sync.py.
# En el plan free solo se usa el modo `db`; RENDER_SSH_HOST es opcional y solo
# hace falta para `files` (plan pagado con disco).
#   RENDER_DATABASE_URL=postgresql://...@dpg-....render.com/tcga
#   RENDER_PG_SSLMODE=require
#   RENDER_SSH_HOST=srv-xxxxxxx@ssh.oregon.render.com

# ------------------------------------------------------------------ scheduler
SCHEDULER_INTERVAL_SECONDS=604800
